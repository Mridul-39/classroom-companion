# Production (Neon PostgreSQL): postgresql://user:pass@host/dbname?sslmode=require
# Local dev (SQLite — only works if schema.prisma still uses sqlite provider):
DATABASE_URL="file:./dev.db"

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN="your-bot-token-here"
APP_BASE_URL="http://localhost:3000"

# Admin teacher user id(s) — comma-separated.
# Admins can suspend/delete users and revoke invites from the web dashboard.
# Use the User.id of a TEACHER row that has a passwordHash so you can log in.
# Find ids with: npx tsx -e "const {PrismaClient}=require('@prisma/client');const db=new PrismaClient();db.user.findMany({where:{role:'teacher'}}).then(console.log).finally(()=>db.\$disconnect())"
ADMIN_TEACHER_IDS=""

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Groq — chat + voice — https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"

# Gmail for invite emails (optional — invites still work via Telegram without this)
# 1. Enable 2-Step Verification on the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password (spaces optional; they are stripped)
EMAIL_ENABLED="true"
EMAIL_USER="your.email@gmail.com"
EMAIL_APP_PASS="xxxx xxxx xxxx xxxx"

# A random secret string — set the same value in Vercel env vars and cron-job.org header
CRON_SECRET="any-random-string-here"
