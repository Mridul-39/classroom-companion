DATABASE_URL="file:./dev.db"

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN="your-bot-token-here"
APP_BASE_URL="http://localhost:3000"

# Admin teacher user id(s) from the database (comma-separated)
ADMIN_TEACHER_IDS="teacher-meera"

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Groq — chat + voice — https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"

# Gmail for invite emails (optional — invites still work via Telegram without this)
# 1. Enable 2-Step Verification on the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password (spaces optional; they are stripped)
EMAIL_ENABLED="true"
EMAIL_USER="your.email@gmail.com"
EMAIL_APP_PASS="xxxx xxxx xxxx xxxx"
